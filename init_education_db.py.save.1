import sqlite3
import os

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DATABASE = os.path.join(BASE_DIR, "database.db")

print("Using database:", DATABASE)

conn = sqlite3.connect(DATABASE)
cursor = conn.cursor()

# ============================================================
# EDUCATION - COURSES
# ============================================================

cursor.execute("""
CREATE TABLE IF NOT EXISTS courses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    category TEXT,
    instructor TEXT,
    level TEXT,
    duration TEXT,
    image_url TEXT,
    course_url TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
""")

# ============================================================
# EDUCATION - STUDY MATERIALS
# ============================================================

cursor.execute("""
CREATE TABLE IF NOT EXISTS study_materials (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    subject TEXT,
    material_type TEXT,
    file_url TEXT,
    image_url TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
""")

conn.commit()

# Verify
cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table'
ORDER BY name
""")

tables = cursor.fetchall()

print("\nDatabase tables:")
for table in tables:
    print("  ✓", table[0])

conn.close()

print("\n========================================")
print("Education database setup completed!")
print("========================================")
